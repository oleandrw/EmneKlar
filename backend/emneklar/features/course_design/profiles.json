  "shared_components": {
    "root": {"max-width": "{max_width}", "margin": "0 auto", "color": "{text}", "font-family": "{font_family}", "font-size": "{font_size}", "line-height": "{line_height}"},
    "h4": {"color": "{heading}"},
    "a": {"color": "{link}", "text-decoration": "underline"},
    "table": {"border-collapse": "collapse", "margin-bottom": "1em", "max-width": "100%"},
    "caption": {"padding": "4px 0", "text-align": "left"},
    "th": {"background-color": "{info_bg}", "color": "{text}", "border": "1px solid {border}", "padding": "6px 10px"},
    "td": {"border": "1px solid {border}", "padding": "6px 10px"},
    "blockquote": {"margin": "1em 0", "padding": "12px 16px", "background-color": "{info_bg}", "border-left": "4px solid {primary}"},
    "pre": {"background-color": "{info_bg}", "border": "1px solid {border}", "border-radius": "{radius_card}", "padding": "12px", "overflow-x": "auto"},
    "hr": {"border": "0", "border-top": "1px solid {border}", "margin": "1.5em 0"},
    "img": {"max-width": "100%", "height": "auto"},
    "iframe": {"max-width": "100%"},
    "video": {"max-width": "100%"},
    "banner": {"background-color": "{banner_bg}", "color": "{banner_text}", "padding": "24px 28px", "border-radius": "{radius_card} {radius_card} 0 0"},
    "banner_title": {"margin": "0", "color": "{banner_text}", "font-size": "1.6em", "line-height": "1.25", "font-family": "{heading_font}"},
    "banner_sub": {"margin": "6px 0 0", "color": "{banner_text}"},
    "body": {"background-color": "{surface}", "border": "1px solid {border}", "border-top": "0", "border-radius": "0 0 {radius_card} {radius_card}", "padding": "8px 28px 24px"},
    "lead": {"font-size": "1.125em"},
    "box_info": {"background-color": "{info_bg}", "border": "1px solid {border}", "border-radius": "{radius_card}", "padding": "0 16px 12px", "margin": "1.2em 0"},
    "box_card": {"background-color": "{surface}", "border": "1px solid {border}", "border-radius": "{radius_card}", "padding": "4px 16px 12px", "margin": "1.2em 0"},
    "box_note": {"background-color": "{info_bg}", "border": "1px solid {label_bg}", "border-radius": "{radius_card}", "padding": "0 16px 12px", "margin": "1.2em 0"},
    "box_label": {"background-color": "{label_bg}", "color": "{label_text}", "margin": "0 -16px 12px", "padding": "6px 16px", "font-size": "1em", "border-radius": "{radius_card} {radius_card} 0 0", "border-bottom": "0"},
    "action": {"display": "inline-block", "background-color": "{primary_dark}", "color": "#ffffff", "padding": "10px 18px", "border-radius": "{radius_action}", "text-decoration": "none"}
  },
  "retired_comment": "Templates from earlier profile versions, per role. They are never applied, only recognised, so content designed with an earlier version loses that styling when a design is applied again (also when Canvas dropped data-ek-d).",
  "retired_components": {
    "box_note": [
      {"since": "2", "template": {"background-color": "{info_bg}", "border-left": "4px solid {primary}", "padding": "8px 16px", "margin": "1.2em 0"}}
    ]
  }
}
